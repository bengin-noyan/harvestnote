{
  "expo": {
    "name": "HarvestNote",
    "slug": "harvestnote",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harvestnote.app"
    },
    "android": {
      "package": "com.harvestnote.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-status-bar"
    ]
  }
}
